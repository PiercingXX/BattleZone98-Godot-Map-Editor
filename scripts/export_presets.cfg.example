; Copy to the project root as export_presets.cfg (gitignored) and adjust paths.
; C10: the shipped build has zero runtime dependencies, and the dev-only trees
; stay out of the .pck. exclude_filter drops tests/ (the suite, the benchmark
; harness and its fixtures), scripts/ (the bash runners and the build-time
; .gd tools) and docs/. Nothing under project/ or scenes/ references any of
; them, so the export is a strict subset of what the editor loads at runtime.
[preset.0]

name="Windows Desktop"
platform="Windows Desktop"
runnable=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="tests/*,scripts/*,docs/*"
export_path="dist/BZ98MapEditor.exe"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

binary_format/embed_pck=true
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
application/icon="res://icon.svg"
