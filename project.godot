; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BattleZone 98 Godot Map Editor"
config/description="Standalone visual map editor for Battlezone 98 Redux"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://project/autoload/Settings.gd"
Backend="*res://project/autoload/Backend.gd"
MapState="*res://project/autoload/MapState.gd"
UndoStack="*res://project/autoload/UndoStack.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.07, 0.075, 0.085, 1)
