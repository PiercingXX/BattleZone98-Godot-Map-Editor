# Godot
.godot/
.import/
export.cfg
export_presets.cfg
*.translation

# Exported builds
build/
dist/

# Editor runtime state (asset cache, sessions, logs) — machine-specific, large
cache/
sessions/
*.log

# Local coding-agent working directories — session data, not project content
.skippy/
.claude/
.cursor/

# OS
.DS_Store
Thumbs.db

# NEVER commit game or workshop content — it is Rebellion's / BZP's, and this
# repo is going public. See AGENTS.md rule 3.
game-assets/
bzp-snapshot/
*.zfs
*.geo
*.sdf
*.msh
*.dds
*.odf
*.bzn
*.hg2
*.mat
*.lgt
*.trn
*.mesh
*.skeleton
*.material
*.vxt
*.des
*.vdf

# In-repo backend templates (not extracted game assets).
!project/backend/reference/
!project/backend/reference/**

# Starter templates — generated from vendored reference data by
# scripts/make_templates.gd, not extracted game assets.
!templates/
!templates/**

# Synthetic test fixtures — hand-authored in
# tests/gd/fixtures/bzn/make_fixtures.gd, no game content. The blanket *.bzn
# ban above is aimed at corpus and workshop maps; it was also hiding these,
# which left five test files skipping on every fresh clone and in CI.
!tests/gd/fixtures/bzn/*.bzn

# The clean-room wall. Format truth lives in docs/formats/; the third-party
# reference addons it was derived from were deleted on purpose and must not
# come back. See AGENTS.md rule 8 and docs/formats/README.md.
resources/
