func _initialize() -> void:
	var ok := true
	ok = _emit("untouched.bzn", geyser("100.25", "12.5", "200.75")) and ok
	# The expected result of set_position(333.125, 44.5, 555.875).
	ok = _emit("mutated_pos.bzn", geyser("333.125", "44.5", "555.875")) and ok
	quit(0 if ok else 1)


func _emit(name: String, geyser_block: String) -> bool:
	var bzn = BzBzn.BznFile.build(
		HEADER,
		[BzBzn.GameObject.from_template(PLAYER), BzBzn.GameObject.from_template(geyser_block)],
		TAIL
	)
	var problems: PackedStringArray = bzn.validate()
	if not problems.is_empty():
		printerr("%s does not validate: %s" % [name, ", ".join(problems)])
		return false
	var path: String = DIR.path_join(name)
	var wr: Dictionary = bzn.write(path)
	if not bool(wr.get("ok", false)):
		printerr("%s: write failed: %s" % [name, str(wr)])
		return false
	print("wrote %s (%d bytes)" % [path, FileAccess.get_file_as_bytes(path).size()])
	return true
