extends SceneTree
## Rebuild the synthetic .bzn fixtures for test_bz_bzn.gd and friends.
##
##   godot --headless --path . -s tests/gd/fixtures/bzn/make_fixtures.gd
##
## The fixtures are committed, so this only needs running when the intended
## content changes. It is here so that content is written down as source
## rather than living only inside two opaque binaries.
##
## Nothing in this file is game data: the header, both objects and the tail are
## hand-authored below, modelled on the shape of a stock ASCII BZN but sharing
## none of its content. "synthmap" is not a real terrain.
##
## `mutated_pos.bzn` is written from its own hand-authored text, NOT by calling
## `set_position` on the geyser. That matters: `test_bz_bzn.gd` asserts that
## `set_position(333.125, 44.5, 555.875)` reproduces this file byte for byte,
## and a golden generated by the routine under test could not fail that.

const DIR := "res://tests/gd/fixtures/bzn"

const HEADER := """version [1] =
2016
binarySave [1] =
false
msn_filename = synthmap.bzn
seq_count [1] =
2
missionSave [1] =
true
TerrainName = synthmap
size [1] =
2"""

const TAIL := """[AiMission]
[AOIs]
